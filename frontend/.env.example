# ─────────────────────────────────────────────
# Variables de entorno del frontend (Torneria Castro)
# Copiar este archivo a .env.local y ajustar los valores:
#   cp .env.example .env.local
#
# NOTA: solo las variables con prefijo VITE_ llegan al cliente
# (import.meta.env). Todo lo que empiece con VITE_ es PUBLICO:
# queda escrito en texto plano dentro del bundle que descarga
# el navegador. NUNCA pongas secretos aca.
# ─────────────────────────────────────────────

# URL base del backend.
# En dev, el proxy de vite.config.ts reenvia /api hacia localhost:3000.
# En prod, nginx hace lo mismo (ADR-009). Por eso el mismo valor sirve en los dos.
VITE_API_URL=/api

# Mocks de API con MSW (Mock Service Worker).
# Poner en 'true' para que el frontend responda /api/* con datos falsos desde
# los *.mocks.ts de cada feature, sin necesidad de backend. En 'false' (o sin
# definir) los requests pegan contra el backend real via el proxy de Vite.
VITE_USE_MOCKS=false

# ─────────────────────────────────────────────
# Variables que lee vite.config.ts (solo el servidor de dev, nunca el bundle).
# OJO: vite.config.ts las lee de process.env, y Vite NO carga los .env* en
# process.env. Ponerlas aca no tiene efecto: van en la shell o en el compose
# (docker-compose.dev.yaml ya las define). Quedan documentadas para saber
# que existen.
# ─────────────────────────────────────────────

# Destino del proxy /api. Por defecto http://localhost:3000; en Docker,
# http://backend:3000.
# API_PROXY_TARGET=http://localhost:3000

# 'true' activa el polling del watcher (necesario con volumenes de Docker en
# Windows/Mac).
# VITE_WATCH_POLLING=false
