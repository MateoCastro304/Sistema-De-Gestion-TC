# ─────────────────────────────────────────────
# Frontend environment variables (Tornería Castro)
# Copy this file to .env.local and adjust the values:
#   cp .env.example .env.local
#
# NOTE: only variables prefixed with VITE_ reach the client
# (import.meta.env). Anything starting with VITE_ is PUBLIC,
# it travels to the browser — NEVER put secrets here.
# ─────────────────────────────────────────────

# Backend base URL. In dev, nginx proxies /api (ADR-009).
VITE_API_URL=/api
