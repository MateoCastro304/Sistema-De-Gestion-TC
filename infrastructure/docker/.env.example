# ─────────────────────────────────────────────
# Variables de entorno de Docker Compose (Torneria Castro)
# Copiar este archivo segun el entorno y ajustar los valores:
#   cp .env.example .env.dev    # make dev-*
#   cp .env.example .env.prod   # make prod-* (NODE_ENV=production y secretos propios)
#   cp .env.example .env.test   # make test-*
#
# El Makefile lo pasa con --env-file (interpolacion de los compose) y el
# backend lo carga con env_file. El backend valida sus variables al arrancar
# (backend/src/config/env.validation.ts). Los valores de este archivo son de
# ejemplo y pasan la validacion: NUNCA los uses en produccion.
# ─────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=torneria_dev
POSTGRES_PASSWORD=torneria_dev
POSTGRES_DB=torneria_dev

# ── Backend ──
# development | production | test
NODE_ENV=development
PORT=3000

# DATABASE_URL no va aca: docker-compose.yaml la arma con las POSTGRES_*
# de arriba y el host del servicio (postgres:5432).

# Minimo 32 caracteres y distintos entre si. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-jwt-access-secret-replace-me-0001
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-replace-me-0002

# Opcionales. Duracion de los tokens (formato 15m, 1h, 7d).
# JWT_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d

# Opcional. Origenes CORS separados por coma. En dev hace falta para Swagger UI
# (:8081). En prod dejarlo sin definir: todo pasa por nginx en el mismo origen.
ALLOWED_ORIGINS=http://localhost:8081

# Cotizacion del dolar (API externa) y zona horaria del negocio
EXCHANGE_RATE_API_URL=https://dolarapi.com/v1/dolares/oficial
APP_TIMEZONE=America/Argentina/Cordoba
# Opcionales. Almacenamiento de archivos: local | s3.
# S3_BUCKET y S3_REGION son obligatorias solo si STORAGE_DRIVER=s3.
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
