# ─────────────────────────────────────────────
# Variables de entorno de Docker Compose (Torneria Castro)
# Copiar este archivo segun el entorno y ajustar los valores:
#   cp .env.example .env.dev    # make dev-*
#   cp .env.example .env.prod   # make prod-* (NODE_ENV=production y secretos propios)
#   cp .env.example .env.test   # make test-*
#
# El Makefile lo pasa con --env-file (interpolacion de los compose) y el
# backend lo carga con env_file. El backend valida sus variables al arrancar
# (backend/src/config/env.validation.ts). Los valores de este archivo son de
# ejemplo y pasan la validacion: NUNCA los uses en produccion.
# ─────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=torneria_dev
POSTGRES_PASSWORD=torneria_dev
POSTGRES_DB=torneria_dev

# ── Backend ──
# development | production | test
NODE_ENV=development
PORT=3000

# DATABASE_URL no va aca: docker-compose.yaml la arma con las POSTGRES_*
# de arriba y el host del servicio (postgres:5432).

# Minimo 32 caracteres y distintos entre si. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-jwt-access-secret-replace-me-0001
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-replace-me-0002

# Opcionales. Duracion de los tokens (formato 15m, 1h, 7d).
# JWT_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d

# Opcional. Origenes CORS separados por coma. En dev hace falta para Swagger UI
# (:8081). En prod dejarlo sin definir: todo pasa por nginx en el mismo origen.
ALLOWED_ORIGINS=http://localhost:8081

# ── Object storage (SeaweedFS en dev, S3 en prod) ──
# Almacenamiento de archivos: local | s3 (por defecto local).
# S3_REGION, S3_BUCKET y S3_BUCKET_UPLOADS son obligatorias si es s3.
STORAGE_DRIVER=s3
# SeaweedFS no usa la region, pero el SDK de AWS la pide.
S3_REGION=us-east-1

# Opcional. Donde se conecta el backend. Sin definir, el de AWS para la region.
S3_ENDPOINT=http://seaweed:8333
# Opcional. El que va en las presigned URLs: lo abre el navegador, que no
# resuelve "seaweed". Sin definir, vale lo mismo que S3_ENDPOINT (prod).
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Opcional (por defecto false). true: el bucket va en el camino de la URL
# (localhost:8333/bucket/...). SeaweedFS lo necesita; en AWS dejarlo sin definir.
S3_FORCE_PATH_STYLE=true
# Cotizacion del dolar (API externa) y zona horaria del negocio
EXCHANGE_RATE_API_URL=https://dolarapi.com/v1/dolares/oficial
APP_TIMEZONE=America/Argentina/Cordoba

# Buckets: archivos del negocio (no expiran), subidas sin confirmar y
# backups de la DB. Minusculas, numeros y guiones; de 3 a 63 caracteres.
S3_BUCKET=torneria-archivos
S3_BUCKET_UPLOADS=torneria-subidas
S3_BUCKET_BACKUPS=torneria-backups

# Credencial del backend, limitada a los buckets de archivos y subidas.
# Van las dos o ninguna: en prod, sin keys, el SDK usa el IAM Role de la EC2.
# Las de backup y admin van en .env.storage.example: el backend carga
# este archivo entero y no tiene que verlas.
# Solo letras y numeros, minimo 16 caracteres. Para generar una:
#   openssl rand -hex 32
S3_BACKEND_ACCESS_KEY=devbackendaccesskey0001
S3_BACKEND_SECRET_KEY=devbackendsecretkeyreplaceme0001

# Origenes que pueden subir y bajar directo del storage (presigned URLs),
# separados por coma. Aparte de ALLOWED_ORIGINS: en prod esa queda vacia y
# esta no.
S3_CORS_ORIGINS=http://localhost,http://localhost:5173
