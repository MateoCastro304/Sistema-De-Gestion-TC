// Schema de la base (Sprint 1 y Sprint 2).
// Diseño: docs/database/cambios-bdd-sprint2.md y docs/database/der-sprint-1-2.md
//
// Lo que Prisma no expresa vive en migraciones escritas a mano. Prisma no lo ve
// al calcular el diff: no lo propone para borrar, pero tampoco lo recrea solo.
//  - Indices unicos parciales o por expresion:
//      factory_customer_cuit_active_key, factory_customer_name_active_key,
//      manager_customer_mail_active_key, supplier_cuit_active_key,
//      supplier_legal_name_active_key, category_name_lower_key,
//      refresh_token_session_active_key
//  - Todos los CHECK (ck_*).
//  - Si una migracion generada trae un DROP INDEX de alguno, quitarlo a mano.
//
// Notas:
//  - `manager_customer` usa PK compuesta (factory_id, id); el `id` correlativo
//    por fabrica lo calcula el repositorio (max + 1 con reintento ante P2002).
//  - Los textos normalizados (`*_key`, `search_key`) los calcula la aplicacion:
//    minusculas, sin acentos y con espacios colapsados (cambios-bdd-sprint2 §6).
// NOTA: la URL de conexion se configura via DATABASE_URL (driver adapter), no aca.

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// =============================================
// Enums
// =============================================

/// Identifica a que tabla apunta file.entity_id (FK polimorfica)
enum EntityType {
  QUOTE_REQUEST
  PART
  QUOTE
  WORK_ORDER

  @@map("entity_type_enum")
}

/// Tipo de documento almacenado
enum DocumentType {
  REQUEST_PDF
  BLUEPRINT
  REFERENCE_PART_PHOTO
  DESIGN_3D
  OTHER

  @@map("document_type_enum")
}

enum SupplierType {
  PROCESS
  REPLACEMENT
  MATERIAL
  PAINT

  @@map("supplier_type_enum")
}

/// Roles del sistema (RN44). Catalogo cerrado.
/// El orden de declaracion es el del prototipo: PostgreSQL ordena los enums
/// asi, y la API devuelve los roles en ese orden.
enum Role {
  JT
  ERP
  EC
  ER
  AT
  AS

  @@map("role_enum")
}

/// Puesto del empleado. No es un rol: no da permisos.
enum EmployeePosition {
  ADMINISTRATION
  WORKSHOP_HEAD
  HEAD
  EMPLOYEE

  @@map("employee_position_enum")
}

/// Motivo de cierre de una sesion
enum SessionEndReason {
  MANUAL
  INACTIVITY
  EXPIRED
  REVOKED

  @@map("session_end_reason_enum")
}

// =============================================
// Files Management
// =============================================

model File {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  s3Bucket     String       @map("s3_bucket") @db.VarChar(255)
  s3Key        String       @unique @map("s3_key") @db.VarChar(1024)
  originalName String       @map("original_name") @db.VarChar(255)
  extension    String       @db.VarChar(10)
  mimeType     String       @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt       @map("size_bytes") // CHECK (size_bytes > 0) en SQL manual
  documentType DocumentType @map("document_type")
  entityType   EntityType   @map("entity_type")
  entityId     Int          @map("entity_id") // FK polimorfica: sin relacion declarada
  uploadedAt   DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("file")
}

// =============================================
// Customer Management
// =============================================

/// Rubro
///
/// `name` es unico sin distinguir mayusculas entre todos los rubros, activos o
/// no (indice category_name_lower_key, en SQL manual).
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  factories Factory[]

  @@map("category")
}

/// Fabrica / empresa cliente (tabla `factory_customer`)
///
/// PENDIENTE: falta `code` (codigo de fabrica, unico, obligatorio, 2-4 caracteres).
/// Ver docs/decisions/decisiones-clientes-fabricas.md, seccion 5.
/// Unicidad (indices parciales creados a mano en la migracion
/// 20261008000000_customers_factories_rules; Prisma no los expresa aca):
///  - cuit: unico entre fabricas ACTIVAS (factory_customer_cuit_active_key)
///  - name: unico entre fabricas ACTIVAS, sin distinguir mayusculas
///    (factory_customer_name_active_key)
model Factory {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  address    String?  @db.VarChar(255)
  cuit       String   @db.VarChar(50)
  payMethod  String?  @map("pay_method") @db.VarChar(255)
  categoryId Int      @map("category_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category   @relation(fields: [categoryId], references: [id])
  managers Customer[]

  /// Regla "rubro con fabricas activas".
  @@index([categoryId])
  @@map("factory_customer")
}

/// Encargado / contacto de una fabrica (tabla `manager_customer`)
model Customer {
  id        Int // correlativo por fabrica; lo calcula CustomerPrismaRepository (max + 1)
  factoryId Int      @map("factory_id")
  name      String   @db.VarChar(50)
  lastName  String?  @map("last_name") @db.VarChar(50)
  phone     String?  @db.VarChar(50)
  mail      String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory       Factory        @relation(fields: [factoryId], references: [id])
  quoteRequests QuoteRequest[]

  @@id([factoryId, id])
  @@map("manager_customer")
}

// =============================================
// Supplier Management
// =============================================

/// Proveedor.
///
/// La baja es logica (`is_active`) y no hay reactivacion: un proveedor dado de
/// baja deja de existir para toda consulta. De ahi que la unicidad de `cuit` y
/// `legal_name` valga solo entre los activos, para que un proveedor inactivo no
/// bloquee para siempre un CUIT o una razon social.
///
/// ATENCION: esa regla vive en dos indices escritos a mano en la migracion
/// 20261008214800_supplier_snake_case_and_active_unique, porque Prisma no sabe
/// expresar indices parciales (WHERE) ni funcionales (LOWER) en el schema:
///
///   supplier_cuit_active_key        UNIQUE (cuit)          WHERE is_active
///   supplier_legal_name_active_key  UNIQUE (LOWER(legal_name)) WHERE is_active
///
/// Por eso `cuit` no lleva @unique aca. Prisma no los ve al calcular el diff
/// (comprobado: no figuran en el reporte de drift), asi que no los va a
/// proponer para borrar; pero tampoco los recrea solo. Si se reescribe esta
/// migracion a mano y se omiten, la base deja de garantizar la unicidad y las
/// altas duplicadas quedan libradas al codigo: verificar con
///   SELECT indexname FROM pg_indexes WHERE tablename = 'supplier';
model Supplier {
  id           Int          @id @default(autoincrement())
  supplierType SupplierType @map("supplier_type")
  cuit         String?      @db.VarChar(50)
  legalName    String       @map("legal_name") @db.VarChar(80)
  contactName  String?      @map("contact_name") @db.VarChar(150)
  address      String?      @db.VarChar(255)
  contactPhone String?      @map("contact_phone") @db.VarChar(50)
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  observation  String?      @db.VarChar(255)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("supplier")
}

// =============================================
// Quote Management
// =============================================

model QuoteRequest {
  id                Int      @id @default(autoincrement())
  managerCustomerId Int      @map("manager_customer_id")
  managerFactoryId  Int      @map("manager_factory_id")
  descp             String?  @db.VarChar(200)
  reqDate           DateTime @map("req_date") @db.Date
  orderNumber       String?  @map("order_number") @db.VarChar(50)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [managerFactoryId, managerCustomerId], references: [factoryId, id])

  @@index([managerFactoryId, managerCustomerId])
  @@map("quote_request")
}

// =============================================
// Staff & Access
// =============================================

/// Empleado: personal de la empresa, con o sin usuario.
model Employee {
  id              Int              @id @default(autoincrement())
  firstName       String           @map("first_name") @db.VarChar(100)
  lastName        String           @map("last_name") @db.VarChar(100)
  /// Solo digitos, 7 u 8 (CHECK). Unico entre todos los empleados, incluidos
  /// los dados de baja (D-15).
  dni             String           @unique @db.VarChar(8)
  position        EmployeePosition
  address         String?          @db.VarChar(200)
  email           String?          @db.VarChar(120)
  phone           String?          @db.VarChar(50)
  /// "nombre apellido" normalizado por la aplicacion. No incluye el DNI: la
  /// busqueda de usuarios no busca por DNI; la de empleados lo suma aparte.
  searchKey       String           @map("search_key") @db.VarChar(201)
  isActive        Boolean          @default(true) @map("is_active")
  /// Trazabilidad, no se expone (D-43). NULL en el empleado del seed inicial.
  createdByUserId Int?             @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User? @relation("UserEmployee")
  createdBy User? @relation("EmployeeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Orden del listado (apellido, nombre).
  @@index([lastName, firstName])
  @@map("employee")
}

/// Usuario del sistema (tabla `app_user`: `user` es palabra reservada).
///
/// El estado no se guarda, se calcula (D-26): INACTIVE si el usuario o su
/// empleado estan dados de baja; si no, BLOCKED si `blocked_at` no es NULL;
/// si no, ACTIVE. `lastAccessAt` es MAX(user_session.started_at) (D-27).
model User {
  id                  Int       @id @default(autoincrement())
  /// Maximo un usuario por empleado, incluidos los dados de baja (D-20).
  employeeId          Int       @unique @map("employee_id")
  /// Se guarda en minusculas (CHECK): unico sin distinguir mayusculas,
  /// incluidos los dados de baja (D-22).
  username            String    @unique @db.VarChar(30)
  /// bcrypt (RNF08). Nunca se devuelve.
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// NULL = no bloqueado. Se desbloquea en CU-06 (D-49).
  blockedAt           DateTime? @map("blocked_at") @db.Timestamptz(6)
  isActive            Boolean   @default(true) @map("is_active")
  createdByUserId     Int?      @map("created_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee      @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  roles     UserRole[]
  sessions  UserSession[]

  createdUsers        User[]                    @relation("UserCreatedBy")
  createdEmployees    Employee[]                @relation("EmployeeCreatedBy")
  createdProcessTypes ProcessType[]             @relation("ProcessTypeCreatedBy")
  createdMaterials    Material[]                @relation("MaterialCreatedBy")
  priceChanges        ProcessTypePriceHistory[]

  @@map("app_user")
}

/// Roles de un usuario. "Al menos uno" lo garantiza el caso de uso (RN44).
model UserRole {
  userId     Int      @map("user_id")
  role       Role
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// La PK compuesta impide repetir un rol.
  @@id([userId, role])
  /// Filtro GET /users?role=
  @@index([role])
  @@map("user_role")
}

/// Sesion del servidor (D-04): una fila por ingreso.
model UserSession {
  /// UUID: viaja en el accessToken (claim `sid`) y no tiene que ser enumerable.
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         Int               @map("user_id")
  startedAt      DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  /// Sin indice a proposito: permite updates HOT (cambios-bdd-sprint2 §7.3).
  lastActivityAt DateTime          @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  /// Inicio + 7 dias (D-44). Es tambien el vencimiento de todos sus refresh tokens.
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  /// `ended_at` y `end_reason` van juntos: los dos NULL o los dos con valor (CHECK).
  endedAt        DateTime?         @map("ended_at") @db.Timestamptz(6)
  endReason      SessionEndReason? @map("end_reason")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  /// lastAccessAt = started_at de la sesion mas reciente (D-27).
  @@index([userId, startedAt(sort: Desc)])
  /// Limpieza periodica.
  @@index([expiresAt])
  @@map("user_session")
}

/// Cadena de rotacion de refresh tokens de una sesion (D-47).
/// Un unico token vigente por sesion: refresh_token_session_active_key
/// (UNIQUE (session_id) WHERE revoked_at IS NULL, en SQL manual).
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SHA-256 en hexadecimal. El token es aleatorio y de alta entropia: no
  /// necesita sal ni hash lento, y un hash deterministico se busca por indice.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  sessionId  String    @map("session_id") @db.Uuid
  /// Token que lo reemplazo al rotar. @unique: la cadena es lineal.
  replacedBy String?   @unique @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Momento de la rotacion o de la revocacion. Margen de reuso de D-47:
  /// revoked_at > now() - 30 segundos.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  session  UserSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replaced RefreshToken? @relation("TokenRotation", fields: [replacedBy], references: [id], onDelete: SetNull)
  previous RefreshToken? @relation("TokenRotation")

  @@index([sessionId])
  @@map("refresh_token")
}

// =============================================
// Technical Catalogs
// =============================================

/// Tipo de proceso con su precio hora (RN16 a RN18).
model ProcessType {
  /// No cambia aunque se renombre el tipo.
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  /// Nombre normalizado por la aplicacion. Unico (D-34). Orden del listado.
  nameKey         String   @unique @map("name_key") @db.VarChar(100)
  description     String?  @db.VarChar(500)
  /// Los dos precios se guardan tal como llegan, sin recalcular (D-29).
  hourlyRateArs   Decimal  @map("hourly_rate_ars") @db.Decimal(12, 2)
  hourlyRateUsd   Decimal  @map("hourly_rate_usd") @db.Decimal(12, 2)
  /// Tipo de cambio de la ultima modificacion de precios (D-52).
  exchangeRate    Decimal  @map("exchange_rate") @db.Decimal(12, 2)
  /// Previsto para la baja (CU-12, otro sprint).
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId Int?     @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy    User?                     @relation("ProcessTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  priceHistory ProcessTypePriceHistory[]

  @@map("process_type")
}

/// Un registro por modificacion que cambia algun precio hora (D-32).
/// Solo el tipo de cambio y los valores en dolares: el valor en pesos es
/// new_value_usd x exchange_rate.
/// Inmutable (RNF10): no hay operacion de escritura despues del INSERT.
model ProcessTypePriceHistory {
  id               Int      @id @default(autoincrement())
  processTypeId    Int      @map("process_type_id")
  changedAt        DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedByUserId  Int      @map("changed_by_user_id")
  exchangeRate     Decimal  @map("exchange_rate") @db.Decimal(12, 2)
  previousValueUsd Decimal  @map("previous_value_usd") @db.Decimal(12, 2)
  newValueUsd      Decimal  @map("new_value_usd") @db.Decimal(12, 2)

  processType ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Restrict)
  changedBy   User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  /// Del mas reciente al mas antiguo.
  @@index([processTypeId, changedAt(sort: Desc), id(sort: Desc)])
  @@map("process_type_price_history")
}

/// Material: nombre + calidad (D-36). Sin precio, proveedor ni presentacion.
/// El orden natural de la calidad ("SAE 9" antes que "SAE 10") lo aplica el
/// repositorio, no la base.
model Material {
  id              Int      @id @default(autoincrement())
  /// Con la grafia del primer material de ese nombre (D-37).
  name            String   @db.VarChar(60)
  quality         String   @db.VarChar(60)
  /// Nombre y calidad normalizados por la aplicacion.
  nameKey         String   @map("name_key") @db.VarChar(60)
  qualityKey      String   @map("quality_key") @db.VarChar(60)
  /// Previsto para la baja (CU-40, otro sprint).
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId Int?     @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User? @relation("MaterialCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Nombre + calidad no se repiten (D-36). Al empezar por name_key, el mismo
  /// indice sirve para el filtro ?name= y para GET /materials/names.
  @@unique([nameKey, qualityKey])
  @@map("material")
}

/// Ultimo tipo de cambio obtenido de la API externa (D-48). Una sola fila
/// (CHECK id = 1), actualizada con upsert.
model ExchangeRate {
  id        Int      @id @default(1) @db.SmallInt
  rate      Decimal  @db.Decimal(12, 2)
  /// Momento de la cotizacion informado por la fuente: el `updatedAt` del contrato.
  quotedAt  DateTime @map("quoted_at") @db.Timestamptz(6)
  /// Proveedor de la cotizacion. Cambiarlo no cambia el endpoint.
  source    String   @db.VarChar(50)
  /// Cuando la obtuvo el backend.
  fetchedAt DateTime @default(now()) @updatedAt @map("fetched_at") @db.Timestamptz(6)

  @@map("exchange_rate")
}
