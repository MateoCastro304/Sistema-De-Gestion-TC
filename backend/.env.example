# ─────────────────────────────────────────────
# Variables de entorno del backend (Torneria Castro)
# Solo para correr el backend fuera de Docker (npm run start:dev).
# Con Docker se usa infrastructure/docker/.env.example.
#   cp .env.example .env
#
# Se validan al arrancar en src/config/env.validation.ts: si falta una
# obligatoria o tiene un formato invalido, la app no levanta.
# Los valores de este archivo son de ejemplo y pasan la validacion.
# ─────────────────────────────────────────────

# development | production | test
NODE_ENV=development
PORT=3000

# Apunta al Postgres del compose de dev (puerto 5432 expuesto en localhost),
# con las mismas credenciales que infrastructure/docker/.env.example.
DATABASE_URL="postgresql://torneria_dev:torneria_dev@localhost:5432/torneria_dev?schema=public"

# Minimo 32 caracteres y distintos entre si. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev-only-jwt-access-secret-replace-me-0001"
JWT_REFRESH_SECRET="dev-only-jwt-refresh-secret-replace-me-0002"

# Opcionales. Duracion de los tokens (formato 15m, 1h, 7d).
# JWT_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d

# Opcional. Origenes CORS separados por coma (Swagger UI corre en :8081).
ALLOWED_ORIGINS=http://localhost:8081
EXCHANGE_RATE_API_URL=https://dolarapi.com/v1/dolares/oficial
APP_TIMEZONE=America/Argentina/Cordoba

# Opcionales. Almacenamiento de archivos: local | s3.
# S3_BUCKET y S3_REGION son obligatorias solo si STORAGE_DRIVER=s3.
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
