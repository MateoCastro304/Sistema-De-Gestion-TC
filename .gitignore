# =============================================================================
#  Tornería Castro — .gitignore
# =============================================================================
#
#  Único .gitignore del repositorio. Cubre la raíz, backend/ (NestJS + Prisma),
#  frontend/ (Vite + Playwright), infrastructure/ y tooling/.
#
#  Convenciones:
#    · Patrones sin "/" inicial  → aplican en cualquier carpeta del repo.
#    · Patrones con ruta         → aplican solo a esa app (ej: backend/...).
#    · Patrones con "!"          → excepciones: re-incluyen algo ignorado.
#
#  Importante: git no puede re-incluir un archivo si ya ignoró la carpeta que
#  lo contiene. Para hacer excepciones dentro de una carpeta, ignorá su
#  contenido ("carpeta/*"), no la carpeta entera ("carpeta/").
#
#  Para saber qué regla ignora un archivo:
#    git check-ignore -v <ruta>
# =============================================================================


# -----------------------------------------------------------------------------
#  Dependencias
# -----------------------------------------------------------------------------
node_modules/


# -----------------------------------------------------------------------------
#  Variables de entorno y secretos
#  Nunca versionar credenciales. Solo se versionan las plantillas .env.example
#  (backend/, frontend/, infrastructure/docker/).
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# Overrides locales de Vite (ej: .env.local, vite.config.local.ts)
*.local


# -----------------------------------------------------------------------------
#  Artefactos de build
# -----------------------------------------------------------------------------
dist/
dist-ssr/
build/

# Cliente de Prisma generado (`prisma generate`)
backend/src/generated/


# -----------------------------------------------------------------------------
#  Tests y cobertura
# -----------------------------------------------------------------------------
coverage/
.nyc_output/

# Playwright (E2E) — rutas definidas en frontend/playwright.config.ts
frontend/e2e/.results/
frontend/e2e/.report/
frontend/blob-report/
frontend/playwright/.cache/


# -----------------------------------------------------------------------------
#  Logs y reportes de diagnóstico
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Reportes de Node (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


# -----------------------------------------------------------------------------
#  Archivos temporales y de ejecución
# -----------------------------------------------------------------------------
.temp/
.tmp/
pids/
*.pid
*.pid.lock


# -----------------------------------------------------------------------------
#  Docker
#  El override es para ajustes locales de cada desarrollador.
# -----------------------------------------------------------------------------
docker-compose.override.yml


# -----------------------------------------------------------------------------
#  Editores e IDEs
#  Para compartir config de VS Code (ej: extensiones recomendadas), cambiar
#  ".vscode/" por ".vscode/*" y agregar debajo "!.vscode/extensions.json".
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~


# -----------------------------------------------------------------------------
#  Sistema operativo
# -----------------------------------------------------------------------------
# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini


# -----------------------------------------------------------------------------
#  Herramientas de IA
#  Configuración local de Claude Code. Los archivos que ya estaban versionados
#  (ej: frontend/.claude/launch.json) siguen versionados.
# -----------------------------------------------------------------------------
.claude/
